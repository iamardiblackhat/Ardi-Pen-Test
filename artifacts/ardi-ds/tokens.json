{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Ardi Design Tokens — DTCG format. Dark navy/electric-cyan security platform palette. THIS FILE IS THE SINGLE SOURCE OF TRUTH. Edit values here only; scripts/build-tokens.mjs regenerates src/index.css and src/generated/tokens.tsx on every save. Colors are hex; the generator converts them to 'H S% L%' HSL channels for CSS custom properties.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#eef4fa", "$description": "Page canvas — cool blue-gray." },
      "foreground": { "$value": "#0b1724", "$description": "Primary text on light surfaces." },
      "border": { "$value": "#c2d4e4" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#0b1724" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#0b1724" },
      "primary": {
        "$value": "#0284c7",
        "$description": "Electric cyan/sky — brand primary. Drives CTA buttons, links, and active states."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#dbeaf5" },
      "secondaryForeground": { "$value": "#0b1724" },
      "muted": { "$value": "#e5eef7" },
      "mutedForeground": { "$value": "#5a7896" },
      "accent": { "$value": "#dbeaf5" },
      "accentForeground": { "$value": "#0b1724" },
      "destructive": { "$value": "#dc2626", "$description": "Critical severity / danger." },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#c2d4e4" },
      "ring": { "$value": "#0284c7" },
      "chart1": { "$value": "#0ea5e9", "$description": "Info / low severity." },
      "chart2": { "$value": "#10b981", "$description": "Success / safe." },
      "chart3": { "$value": "#8b5cf6", "$description": "Medium severity." },
      "chart4": { "$value": "#f59e0b", "$description": "High severity." },
      "chart5": { "$value": "#ef4444", "$description": "Critical severity." },
      "sidebar": { "$value": "#f0f6fc" },
      "sidebarForeground": { "$value": "#1a3450" },
      "sidebarBorder": { "$value": "#c2d4e4" },
      "sidebarPrimary": { "$value": "#0284c7" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#dbeaf5" },
      "sidebarAccentForeground": { "$value": "#1a3450" },
      "sidebarRing": { "$value": "#0284c7" }
    },
    "dark": {
      "background": { "$value": "#07101b", "$description": "Deep navy page canvas — primary surface for the dark UI." },
      "foreground": { "$value": "#dce8f4", "$description": "Primary text on dark surfaces." },
      "border": { "$value": "#142030" },
      "card": { "$value": "#0d1b2a", "$description": "Card elevation sits just above background." },
      "cardForeground": { "$value": "#dce8f4" },
      "popover": { "$value": "#0d1b2a" },
      "popoverForeground": { "$value": "#dce8f4" },
      "primary": {
        "$value": "#0ea5e9",
        "$description": "Electric sky-blue brand primary — pops on the dark navy canvas."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#112236" },
      "secondaryForeground": { "$value": "#b8cfe6" },
      "muted": { "$value": "#0f1c2d" },
      "mutedForeground": { "$value": "#6482a0" },
      "accent": { "$value": "#0c2d48", "$description": "Deep teal accent for hover/active states." },
      "accentForeground": { "$value": "#7dd3fc" },
      "destructive": { "$value": "#dc2626" },
      "destructiveForeground": { "$value": "#fef2f2" },
      "input": { "$value": "#142030" },
      "ring": { "$value": "#0ea5e9" },
      "chart1": { "$value": "#0ea5e9", "$description": "Info / informational." },
      "chart2": { "$value": "#10b981", "$description": "Success / low severity." },
      "chart3": { "$value": "#a78bfa", "$description": "Medium severity." },
      "chart4": { "$value": "#f59e0b", "$description": "High severity." },
      "chart5": { "$value": "#ef4444", "$description": "Critical severity." },
      "sidebar": { "$value": "#060d16", "$description": "Sidebar sits one step darker than page background." },
      "sidebarForeground": { "$value": "#b8cfe6" },
      "sidebarBorder": { "$value": "#101e2e" },
      "sidebarPrimary": { "$value": "#0ea5e9" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#0c2035" },
      "sidebarAccentForeground": { "$value": "#7dd3fc" },
      "sidebarRing": { "$value": "#0ea5e9" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "sans-serif"],
        "$description": "Primary UI typeface — clean, legible at small sizes, humanist."
      },
      "serif": {
        "$value": ["Lora", "Georgia", "serif"],
        "$description": "Rarely used; available for long-form report content."
      },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "monospace"],
        "$description": "Code snippets, CVE IDs, terminal output, finding details."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.375rem",
      "$description": "Slightly tighter radius than default — suits the precise, technical aesthetic of a security platform."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step. Components multiply this."
    }
  }
}
