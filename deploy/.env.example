# Ardi environment configuration.
#
# Copy to /opt/ardi/.env on the server (or ./.env for local development) and
# fill in real values. NEVER commit the filled-in file — it is gitignored.
#
# Vars below marked (code) are read by code that exists today; those marked
# (planned) are consumed by work still in progress and are listed so the file
# stays the single place to look.

# ── Core ─────────────────────────────────────────────────────────────────────

# (code) Postgres connection string. lib/db throws at boot if unset.
# On the server the password is in /var/lib/ardi/.db_password
DATABASE_URL=postgresql://ardi:CHANGE_ME@localhost:5432/ardi

# (code) Port the API server listens on. Caddy proxies /api/* here.
PORT=8080

# (code) "production" on the server, "development" locally.
NODE_ENV=production

# (code) pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info


# ── Authentication (code) ────────────────────────────────────────────────────

# Signing secret for session tokens. Generate a fresh one per environment:
#   openssl rand -base64 48
# Never reuse the development value in production, and never commit it.
JWT_SECRET=

# Origin allowed to call the API. Same-origin deployment means this is just
# your public URL. Do NOT set it to "*" — the API is authenticated.
# REQUIRED when NODE_ENV=production — the server refuses to boot without it,
# rather than silently allowing any origin.
CORS_ORIGIN=https://ardi.example.com

# (code) Set to "true" only when the API sits behind a reverse proxy you
# control (e.g. the Caddy setup in this repo). Enables trusting the
# X-Forwarded-For header for the tripwire/rate-limit middlewares' IP
# tracking. Leave unset if the API is reachable directly — otherwise a client
# can spoof this header and get an innocent IP blocked.
TRUST_PROXY=true


# ── ARDI, the AI assistant (code) ────────────────────────────────────────────
#
# ARDI needs ONE of the two provider configs below. Anthropic is the default;
# set ARDI_PROVIDER=openai-compat (or just ARDI_BASE_URL) to run a local
# model instead — no per-token cost, and no client data leaves the machine.

# Anthropic API key. SERVER-SIDE ONLY — this must never reach the browser.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model ARDI runs on via the Anthropic API.
ANTHROPIC_MODEL=claude-opus-5

# Alternative: point ARDI at any OpenAI-compatible server (LM Studio, Ollama,
# a local vLLM instance, …) instead of Anthropic.
# ARDI_PROVIDER=openai-compat
# ARDI_BASE_URL=http://localhost:11434/v1
# ARDI_MODEL=llama3.1
# ARDI_API_KEY=


# ── CyberStrike, the autonomous pentest engine (optional) ────────────────────
#
# The premium scan tier. Drives a separately-running `cyberstrike serve`
# process over HTTP. Leave CYBERSTRIKE_URL/PASSWORD unset and Ardi falls back
# to its built-in nmap/nuclei runners (the free-tier scan engine).

CYBERSTRIKE_URL=http://127.0.0.1:4096
CYBERSTRIKE_PASSWORD=
CYBERSTRIKE_PROVIDER=
CYBERSTRIKE_MODEL=


# ── Threat intelligence: OpenCTI (optional — lib/threat-intel) ───────────────
#
# Entirely optional. Leave both blank and Ardi runs normally without
# enrichment. Set BOTH or NEITHER — half-configured throws at boot on purpose,
# because a typo'd URL silently disabling threat intel is the failure that
# goes unnoticed for months.

OPENCTI_URL=
OPENCTI_TOKEN=
OPENCTI_TIMEOUT_MS=20000

# Organisation name stamped on outbound STIX bundles.
OPENCTI_PRODUCER_NAME=Ardi

# Traffic Light Protocol marking on exported findings.
# clear | green | amber | amber+strict | red
# Default is deliberately restrictive: exports describe live client weaknesses.
OPENCTI_EXPORT_TLP=amber+strict


# ── Scanner (code — the free-tier fallback engine) ───────────────────────────

# Absolute paths to the scanner binaries on this host.
NMAP_PATH=/usr/bin/nmap
NUCLEI_PATH=/usr/local/bin/nuclei
NUCLEI_TEMPLATES_DIR=/var/lib/ardi/nuclei-templates

# NOTE: reports are generated on demand at GET /api/reports/:id/download
# (HTML or JSON, built from the caller's live findings) — nothing is written to
# disk, so no REPORTS_DIR is needed. A true server-side PDF (vs. browser
# print-to-PDF of the HTML) would need a rendering lib; not added yet.


# ── Local development only ───────────────────────────────────────────────────

# (code) Vite dev server settings. Not used in production — the SPA is built
# to static files and served by Caddy.
# BASE_PATH=/
# API_PROXY_TARGET=http://localhost:8080
