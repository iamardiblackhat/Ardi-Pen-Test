.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Local caches and tool state
.cache/
.local/

# Secrets. Never commit a filled-in environment file — these hold the JWT
# signing secret, the database password and the Anthropic API key.
# deploy/.env.example is the committed template and holds no real values.
.env
.env.*
!.env.example
!deploy/.env.example

